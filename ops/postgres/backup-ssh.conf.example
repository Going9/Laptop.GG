Host laptopgg-backup
    HostName <app-private-ip>
    User laptopgg-backup
    IdentityFile /var/lib/postgresql/.ssh/laptopgg_backup_ed25519
    UserKnownHostsFile /var/lib/postgresql/.ssh/laptopgg_backup_known_hosts
    StrictHostKeyChecking yes
    UpdateHostKeys no
    BatchMode yes
    ConnectTimeout 10
    ServerAliveInterval 30
    ServerAliveCountMax 3
